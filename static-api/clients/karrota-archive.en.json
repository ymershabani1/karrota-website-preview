ent/img-d6de0a47b0.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-1861910a30.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-5e74752153.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-4f74aadd66.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-33a0bd1bcb.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-7f85ed0689.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-5f91692daa.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-62ad6c2f55.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-213963ea1f.jpg","alt":""}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"2005 - 2010"}},{"type":"image","data":{"image":"storage/projects/page-content/img-460d361c8b.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-a86eaa2dd6.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-71ad244553.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-89884d29b4.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-0ca8387be7.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-70de2ab529.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-2e71022cab.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-89cfdf7398.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-14ef635260.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-27b7c7a71e.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-fc15891d8d.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-ae68d8df7d.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-c190323f98.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-de11240d33.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-86f7aed472.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-6b9656525d.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-ded9de4538.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-6c8fda5238.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-552a75e034.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-09aa7ac75c.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-02b5200ca2.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-f95a78110a.jpg","alt":""}}]},{"id":194,"title":"Green Call","slug":"green-call","year":"2023","description":"With great honour and dedication we worked with GIZ on a project that is close to our hearts, and a theme that is becoming an urgent matter day by day: \"waste management and the circular economy”. Together, we devised the campaign \"Think green, act green.\" Using the colours of the Earth, we aimed to describe our planet through a unique symbol in the project's logo, creating an emblem presented in all the accompanying materials of this campaign.\n\nWe launched the campaign by organising an event with the support of the Ministry of Environment and Spatial Planning of Kosovo, the European Commissio…","body_html":null,"cover_image":"storage/projects/green-call-25e3e88a43.jpg","is_featured":false,"services":["Campaign","Strategy"],"industries":["Public","Awareness"],"content":[{"type":"paragraph","data":{"content":"<p>With great honour and dedication we worked with GIZ on a project that is close to our hearts, and a theme that is becoming an urgent matter day by day: \"waste management and the circular economy”. Together, we devised the campaign \"Think green, act green.\" Using the colours of the Earth, we aimed to describe our planet through a unique symbol in the project's logo, creating an emblem presented in all the accompanying materials of this campaign.</p>"}},{"type":"image","data":{"image":"storage/projects/page-content/img-9f5c616f4d.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-37fbd2670c.jpg","alt":""}},{"type":"paragraph","data":{"content":"<p>We launched the campaign by organising an event with the support of the Ministry of Environment and Spatial Planning of Kosovo, the European Commission, the Government of Germany, and many other stakeholders. During this event, we presented various activities as part of this campaign.<br>We began with a humble initiative called 'Keep it in your pocket.' This simple action serves as a starting point for many positive habits, a call to keep small waste in your pockets, this way children become more attentive towards a cleaner environment in which they live in. To support this activity, we created an attractive and informative illustrated book for children, delivering the message of environmental conservation through an enchanting fairy tale. 'Keep it in your pocket' was introduced at the SOS Villages in Kosovo as an educational and inspirational tool for environmental protection.</p>"}},{"type":"image_row","data":{"columns":3,"images":[{"image":"storage/projects/page-content/img-4342dd869e.jpg","alt":""},{"image":"storage/projects/page-content/img-516ec8a133.jpg","alt":""},{"image":"storage/projects/page-content/img-2d3155f173.jpg","alt":""}]}},{"type":"paragraph","data":{"content":"<p>Our efforts continued with small yet significant activities. This time, we encouraged citizens to pick up trash during their walks, inspired by a popular recreational initiative that originated in Sweden called ‘Plogging’. We named it 'KAPEC,' derived from the main activity and a combination of the words in Albanian 'KAP/Pick' and 'EC/Walk.' A considerable number of citizens joined this call that we encountered during our walk in Gërmia Park.</p>"}},{"type":"image","data":{"image":"storage/projects/page-content/img-d5be926dd9.jpg","alt":""}},{"type":"paragraph","data":{"content":"<p>The next activity, 'Ctrl, Alt, Del,' took us to the primary schools in Prishtina 'Shkolla e Gjelbër' and 'Nazim Gafurri'. Through competitions, we explained to the children how recycling is done and discussed its importance.</p>"}},{"type":"image","data":{"image":"storage/projects/page-content/img-0e0d00b3ef.jpg","alt":""}},{"type":"paragraph","data":{"content":"<p>Our enthusiasm remains undiminished as we continue to collaborate with GIZ on their future projects, steadfastly pursuing the dream of a greener and more sustainable world.</p>"}},{"type":"image","data":{"image":"storage/projects/page-content/img-20efb1c275.jpg","alt":""}},{"type":"image","data":{"image":"storage/projects/page-content/img-2bfa0722a5.jpg","alt":""}}]},{"id":179,"title":"All of Our Animations","slug":"all-animations","year":"2022","description":"Throughout the years, we have created many animations for various clients in various fields. Below are all our animations in chronological order.\n\nMydev\n\nCreate the website of your dreams\n\nhttps://www.youtube.com/watch?v=SoW4Fz9SG8w&t=1s&ab_channel=Karrota\n\nClose to your customers\n\nhttps://www.youtube.com/watch?v=u3py7mgY6Ts&ab_channel=Karrota\n\nBecome Top Rated\n\nhttps://www.youtube.com/watch?v=ws7ikr4T7d4&ab_channel=Karrota\n\nEverything is in the palm of your hand\n\nhttps://www.youtube.com/watch?v=PpQpRlTMW5g&ab_channel=Karrota\n\nCPV\n\nDo not be silent!\n\nhttps://www.youtube.com/watch?v=gs8XWwVpjSk…","body_html":null,"cover_image":"storage/projects/all-animations-4b4af7ba88.jpg","is_featured":false,"services":["Animation"],"industries":[],"content":[{"type":"paragraph","data":{"content":"<p>Throughout the years, we have created many animations for various clients in various fields. Below are all our animations in chronological order.</p>"}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"Mydev"}},{"type":"paragraph","data":{"content":"<p>Create the website of your dreams</p>"}},{"type":"paragraph","data":{"content":"<p>Close to your customers</p>"}},{"type":"paragraph","data":{"content":"<p>Become Top Rated</p>"}},{"type":"paragraph","data":{"content":"<p>Everything is in the palm of your hand</p>"}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"CPV"}},{"type":"paragraph","data":{"content":"<p>Do not be silent!</p>"}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"SHWABO"}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"OSCE - ALBANIA"}},{"type":"paragraph","data":{"content":"<p>How legislation is drafted and processed in Republic of Albania</p>"}},{"type":"paragraph","data":{"content":"<p>Mechanisms available for citizens of Albania to get involved in decision<br>making and parliamentary oversight</p>"}},{"type":"paragraph","data":{"content":"<p>Role of women inParliament and decision making</p>"}},{"type":"heading","data":{"level":"h2","text":"OSCE - KOSOVO"}},{"type":"paragraph","data":{"content":"<p>See more: <a href=\"https://karrota.wtf/osce\">High Awareness</a></p>"}},{"type":"paragraph","data":{"content":"<p>The title is not news! Awareness campaign against misinformation of the media and fake news.</p>"}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"Birra Peroni"}},{"type":"paragraph","data":{"content":"<p>See more: <a href=\"https://karrota.wtf/en/peroni/\">Give It a Kiss!</a></p>"}},{"type":"paragraph","data":{"content":"<p>Pa Panik Plako!</p>"}},{"type":"paragraph","data":{"content":"<p>Pucitim Penalla!</p>"}},{"type":"separator","data":[]},{"type":"heading","data":{"level":"h2","text":"Ambas